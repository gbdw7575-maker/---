# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/health?charset=utf8mb4
# 开发时可用 SQLite（无需安装 MySQL）
# DATABASE_URL=sqlite:///./health.db

# DeepSeek API（AI 分析 + 体检报告 OCR）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

# App
APP_NAME=智能化健康管理系统
APP_VERSION=1.0.0
DEBUG=true
